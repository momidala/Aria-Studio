{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GravityAR",
  "scopeName": "source.gravityar",
  "fileTypes": ["grav", "gravity"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#built-in-types" },
    { "include": "#aria-classes" },
    { "include": "#aria-methods" },
    { "include": "#function-definition" },
    { "include": "#class-definition" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gravityar",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gravityar",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gravityar",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gravityar",
              "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.gravityar",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.gravityar",
              "match": "\\\\(['\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gravityar",
          "match": "\\b([0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?|0[xX][0-9a-fA-F]+)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gravityar",
          "match": "\\b(if|else|switch|case|default|while|for|in|repeat|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.gravityar",
          "match": "\\b(func|var|class|enum|struct|import|extern)\\b"
        },
        {
          "name": "keyword.other.modifier.gravityar",
          "match": "\\b(static|private|public|internal)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.gravityar",
          "match": "\\b(true|false|null|undefined)\\b"
        }
      ]
    },
    "built-in-types": {
      "patterns": [
        {
          "name": "support.type.gravityar",
          "match": "\\b(Int|Float|String|Bool|List|Map|Range|Object|Closure)\\b"
        }
      ]
    },
    "aria-classes": {
      "patterns": [
        {
          "name": "support.class.gravityar",
          "match": "\\b(Aria|GPS|Input|Audio|System|Math)\\b"
        }
      ]
    },
    "aria-methods": {
      "patterns": [
        {
          "name": "support.function.gravityar",
          "match": "\\b(createObject|setPosition|setRotation|setScale|getPosition|getRotation|getScale|setAnchor|destroy|createAnchor|distance|bearing|getPlayerPosition|onTap|onDoubleTap|onSwipe|onPinch|onPan|play3D|play|setMasterVolume|getMasterVolume|print)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.gravityar" },
            "2": { "name": "entity.name.function.gravityar" }
          }
        }
      ]
    },
    "class-definition": {
      "patterns": [
        {
          "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.gravityar" },
            "2": { "name": "entity.name.class.gravityar" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gravityar",
          "match": "(\\+|\\-|\\*|\\/|%|=|==|!=|<|>|<=|>=|&&|\\|\\||!|\\.\\.|\\+\\+|\\-\\-)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.gravityar",
          "match": ";"
        },
        {
          "name": "punctuation.separator.gravityar",
          "match": ","
        },
        {
          "name": "punctuation.accessor.gravityar",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.gravityar",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.gravityar",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.gravityar",
          "match": "[()]"
        }
      ]
    }
  }
}
