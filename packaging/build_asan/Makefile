	$(MAKE) $(MAKESILENT) -f CMakeFiles/therd-package.dir/build.make CMakeFiles/therd-package.dir/therd_package.c.i
.PHONY : therd_package.c.i

therd_package.s: therd_package.c.s
.PHONY : therd_package.s

# target to generate assembly for a file
therd_package.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/therd-package.dir/build.make CMakeFiles/therd-package.dir/therd_package.c.s
.PHONY : therd_package.c.s

