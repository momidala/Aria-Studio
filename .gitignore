# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node/NPM (for VSCode extension)
node_modules/
out/
.vscode-test/
*.vsix

# Build artifacts
*.o
*.a
therd-package
build_pkg/
build_audit/
build_win/

# Generated packages (do not commit — built from source)
*.zip

# Editor files
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Platform-level planning (managed in THerD-platform)
.planning/

# TypeScript incremental build state
*.tsbuildinfo

# Installer staging kit — pre-built artifacts for installer/dist/ are intentionally
# committed so the Windows user can compile the installer without rebuilding from source.
# These negations override the dist/, *.zip, and *.vsix rules above.
!installer/dist/
!installer/dist/gravityar-0.1.0.vsix
!installer/dist/gravityar-blender-1.0.0.zip
!installer/dist/hello-park.therd

# Compiled installer output — do not commit the resulting .exe or the output/ dir
installer/output/
